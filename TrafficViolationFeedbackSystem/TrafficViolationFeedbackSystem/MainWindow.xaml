<Window x:Class="TrafficViolationFeedbackSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficViolationFeedbackSystem"
        mc:Ignorable="d"
        Title="Admin Dashboard" Height="450" Width="800">
    <Grid>
        <!-- Sidebar -->
        <Grid Width="200" Background="LightGray" HorizontalAlignment="Left">
            <StackPanel Margin="10">
                <TextBlock Text="⚙️ Admin Panel" FontWeight="Bold" FontSize="18" Margin="0 10"/>

                <Button Content="👤 Manage Accounts"                 
                Margin="0 5" Height="40"
                Background="Transparent" BorderThickness="0"
                FontSize="14" Foreground="Black"
                HorizontalContentAlignment="Left" Padding="10 0"
                Command="{Binding NavigateCommand}" 
                CommandParameter="UserManagement"    />

                <Button Content="📊 Violation Statistics"
                Margin="0 5" Height="40"
                Background="Transparent" BorderThickness="0"
                FontSize="14" Foreground="Black"
                HorizontalContentAlignment="Left" Padding="10 0"
                Command="{Binding NavigateCommand}" 
                CommandParameter="Report"         />

                <Button Content="🚦 Violation Types"
                Margin="0 5" Height="40"
                Background="Transparent" BorderThickness="0"
                FontSize="14" Foreground="Black"
                HorizontalContentAlignment="Left" Padding="10 0"
                Command="{Binding NavigateCommand}" 
                CommandParameter="ViolationType"         />

                <Button Content="📜 Activity Logs"
                Margin="0 5" Height="40"
                Background="Transparent" BorderThickness="0"
                FontSize="14" Foreground="Black"
                HorizontalContentAlignment="Left" Padding="10 0"
                Command="{Binding NavigateCommand}" 
                CommandParameter="AuditLog"         />

                <Button Content="🔙 Logout"
                Width="120" 
                Margin="0 20 0 5" Height="40"
                Background="#FF6B6B" Foreground="White"
                BorderThickness="0" FontWeight="Bold"              
                Command="{Binding LogoutCommand}" />        
            </StackPanel>
        </Grid>

        <!-- Content Area -->      
        <Grid Margin="200,0,0,0">
            
            <Image Source="/Image/admin.jpg"
            Stretch="UniformToFill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="0"
            Visibility="{Binding ImageVisibility}" />     
            
            <!-- Main Content -->
            <ContentControl Margin="10" Content="{Binding CurrentView}" />
            
        </Grid>
    </Grid>
</Window>
