<UserControl x:Class="TrafficViolationFeedbackSystem.UserUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" Text="Update User" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- User ID -->
        <TextBlock Grid.Row="1" Text="User ID:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Margin="100,0,0,10" Width="300" Text="{Binding UpdatedUser.UserId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False"/>

        <!-- FullName -->
        <TextBlock Grid.Row="2" Text="Full Name:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Margin="100,0,0,10" Width="300" Text="{Binding UpdatedUser.FullName, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Email -->
        <TextBlock Grid.Row="3" Text="Email:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Margin="100,0,0,10" Width="300" Text="{Binding UpdatedUser.Email, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Password -->
        <TextBlock Grid.Row="4" Text="Password:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Margin="100,0,0,10" Width="300" Text="{Binding UpdatedUser.Password, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Phone -->
        <TextBlock Grid.Row="5" Text="Phone:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Margin="100,0,0,10" Width="300" Text="{Binding UpdatedUser.Phone, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Address -->
        <TextBlock Grid.Row="6" Text="Address:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Margin="100,0,0,10" Width="300" Text="{Binding UpdatedUser.Address, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Role -->
        <TextBlock Grid.Row="7" Text="Role:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="7" x:Name="RoleComboBox" Margin="100,0,0,10" Width="300"
                  SelectedValue="{Binding UpdatedUser.Role, UpdateSourceTrigger=PropertyChanged}" 
                  SelectedValuePath="Tag">
            <ComboBoxItem Content="Citizen" Tag="Citizen"/>
            <ComboBoxItem Content="TrafficPolice" Tag="TrafficPolice"/>
            <ComboBoxItem Content="Admin" Tag="Admin"/>
        </ComboBox>

        <!-- Update Button -->
        <Button Grid.Row="8" Content="Update" Margin="0,20,0,0" Padding="10,2" 
                Command="{Binding UpdateCommand}" HorizontalAlignment="Right" Width="100"/>
    </Grid>
</UserControl>