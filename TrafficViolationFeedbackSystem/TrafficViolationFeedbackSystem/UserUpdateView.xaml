<UserControl x:Class="TrafficViolationFeedbackSystem.UserUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid Margin="20">
        <Border Background="#F5F7FA" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <TextBlock Grid.Row="0" Text="Update User" FontSize="28" FontWeight="Bold" 
                           Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="#2C3E50"/>

                <!-- User ID -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="User ID:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding UpdatedUser.UserId, UpdateSourceTrigger=PropertyChanged}" 
                             IsEnabled="False" Background="#ECF0F1" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- FullName -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Full Name:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding UpdatedUser.FullName, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Email -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Email:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding UpdatedUser.Email, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Password -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Password:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding UpdatedUser.Password, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Phone -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Phone:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding UpdatedUser.Phone, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Address -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Address:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding UpdatedUser.Address, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Role -->
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Role:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <ComboBox Grid.Column="1" Margin="0,5,0,5" Width="300" 
                              SelectedValue="{Binding UpdatedUser.Role, UpdateSourceTrigger=PropertyChanged}" 
                              SelectedValuePath="Tag" Background="#FFFFFF" BorderBrush="#BDC3C7" >
                        <ComboBoxItem Content="Citizen" Tag="Citizen"/>
                        <ComboBoxItem Content="TrafficPolice" Tag="TrafficPolice"/>
                        <ComboBoxItem Content="Admin" Tag="Admin"/>
                    </ComboBox>
                </Grid>

                <!-- Update Button -->
                <Button Grid.Row="8" Content="Update" Margin="0,20,20,0" Padding="15,5" 
                        Command="{Binding UpdateCommand}" HorizontalAlignment="Right" Width="120" Background="#2ECC71" 
                        Foreground="White" BorderThickness="0" >
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
