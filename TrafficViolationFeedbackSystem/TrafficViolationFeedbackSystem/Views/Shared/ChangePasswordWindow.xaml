<Window x:Class="TrafficViolationFeedbackSystem.Views.Shared.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi Mật Khẩu" Height="360" Width="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Mật khẩu hiện tại -->
            <RowDefinition Height="Auto"/>
            <!-- Mật khẩu mới -->
            <RowDefinition Height="Auto"/>
            <!-- Xác nhận -->
            <RowDefinition Height="*"/>
            <!-- Spacer -->
            <RowDefinition Height="Auto"/>
            <!-- Nút -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Đổi mật khẩu" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Current Password -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Mật khẩu hiện tại" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox VerticalContentAlignment="Center" x:Name="txtCurrentPassword" Height="30"/>
        </StackPanel>

        <!-- New Password -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Mật khẩu mới" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox VerticalContentAlignment="Center" x:Name="txtNewPassword" Height="30"/>
        </StackPanel>

        <!-- Confirm New Password -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Xác nhận mật khẩu mới" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox VerticalContentAlignment="Center" x:Name="txtConfirmPassword" Height="30"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 0,0,0">
            <Button x:Name="btnCancel" Content="Hủy" Width="90" Height="35" Margin="0,0,10,0" Click="btnCancel_Click"/>
            <Button x:Name="btnSubmit" Content="Xác nhận" Width="110" Height="35"
                    Background="#007BFF" Foreground="White" Click="btnSubmit_Click"/>
        </StackPanel>
    </Grid>
</Window>
