<UserControl x:Class="TrafficViolationFeedbackSystem.Views.Authentication.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">

    <Grid Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="Đặt lại mật khẩu"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,25"
                       HorizontalAlignment="Center"
                       Foreground="#333"/>

            <TextBlock Text="Mật khẩu mới" FontSize="14"/>
            <PasswordBox VerticalContentAlignment="Center" x:Name="txtNewPassword" Height="30" Margin="0,5,0,15"/>

            <TextBlock Text="Xác nhận mật khẩu" FontSize="14"/>
            <PasswordBox VerticalContentAlignment="Center" x:Name="txtConfirmPassword" Height="30" Margin="0,5,0,25" KeyDown="txtConfirmPassword_KeyDown"/>

            <Button x:Name="btnReset" Content="Đặt lại" 
                Height="40" 
                Background="#007BFF" 
                Foreground="White" 
                FontSize="16"
                FontWeight="Medium"
                Click="btnReset_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056b3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock x:Name="tblGoToLogin" Text="Quay lại đăng nhập"
           FontSize="12"
           Foreground="#007BFF"
           HorizontalAlignment="Center"
           Margin="15,20,0,0"
           Cursor="Hand" MouseLeftButtonDown="tblGoToLogin_MouseLeftButtonDown">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style></TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
