<Window x:Class="TrafficViolationFeedbackSystem.Views.Authentication.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrafficViolationFeedbackSystem.Views.Authentication"
        Title="Đăng nhập hệ thống" Width="1344" Height="756"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>

        <!-- Bên trái -->
        <Image Grid.Column="0" Source="/Assets/Image/banner_login.png" Stretch="Fill"/>

        <!-- Bên phải -->
        <Border Grid.Column="1" Background="#F5F5F5">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>
