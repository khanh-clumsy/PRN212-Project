<Window x:Class="TrafficViolationFeedbackSystem.Views.UserDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficViolationFeedbackSystem.Views"
        mc:Ignorable="d"
        Title="TrafficTrack Dashboard" Height="804" Width="1581" Background="#F0F4F8"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Style cho nút chức năng -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056b3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="0.8*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#F5F5F5">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🚗 TrafficTrack" FontSize="40" Foreground="#007BFF" FontWeight="Bold" Margin="20" HorizontalAlignment="Center"/>
                <Button Content="🏠 Trang chủ" Style="{StaticResource ModernButton}" Margin="10,5" Background="Transparent" Foreground="#007BFF" HorizontalAlignment="Center"/>
                <Button Content="👤 Hồ sơ cá nhân" Style="{StaticResource ModernButton}" Margin="10,5" Background="Transparent" Foreground="#007BFF" Click="Profile_Click" HorizontalAlignment="Center"/>
                <Button Content="📊 Thống kê" Style="{StaticResource ModernButton}" Margin="10,5" Background="Transparent" Foreground="#007BFF" HorizontalAlignment="Center"/>
                <Button Content="⚙️ Cài đặt" Style="{StaticResource ModernButton}" Margin="10,5" Background="Transparent" Foreground="#007BFF" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Nội dung chính -->
        <Grid Margin="316,0,0,0" Grid.ColumnSpan="2">
            <Grid.Background>
                <ImageBrush TileMode="Tile" ImageSource="/Assets/Image/imageTraffic.png"/>
            </Grid.Background>

            <!-- Bố cục lưới 3x3 để căn giữa các nút, đẩy lên trên -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nút 1: Gửi phản ánh vi phạm (trên cùng, bên trái) -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ModernButton}" Content="🚦 Gửi phản ánh vi phạm" Click="ReportViolation_Click"/>

                <!-- Nút 2: Xem phản hồi vi phạm (trên cùng, bên phải) -->
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ModernButton}" Content="📩 Xem phản hồi vi phạm" Click="ViewFeedback_Click"/>

                <!-- Nút 3: Phản hồi/Kháng cáo (dưới cùng, bên trái) -->
                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ModernButton}" Content="⚖️ Phản hồi/Kháng cáo" Click="Appeal_Click"/>

                <!-- Nút 4: Nộp phạt (dưới cùng, bên phải) -->
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ModernButton}" Content="💳 Nộp phạt" Click="PayFine_Click"/>

                <!-- Nút 5: Xem vi phạm của tôi (giữa trung tâm, nhưng đẩy lên) -->
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernButton}" Content="🔍 Xem vi phạm của tôi" Click="ViewMyViolations_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>