<UserControl x:Class="TrafficViolationFeedbackSystem.Views.Admin.EditUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficViolationFeedbackSystem.Views.Admin"
        mc:Ignorable="d"
        d:DesignHeight="756" d:DesignWidth="1144">
    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="#FFFFFF">
        <Grid Margin="40,24,40,56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="217*"/>
                <ColumnDefinition Width="845*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề -->
            <TextBlock Grid.Row="0" 
                       Text="Sửa tài khoản" 
                       FontSize="30" 
                       FontWeight="Bold" 
                       Foreground="#007BFF" 
                       Margin="0,20,0,30"
                       HorizontalAlignment="Left" Grid.ColumnSpan="2"/>

            <!-- Form nhập thông tin -->
            <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="20" Background="#F9F9F9" Grid.ColumnSpan="2" Margin="0,0,0,92" Grid.RowSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Họ tên:" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtFullName" Grid.Row="0" Grid.Column="1" Margin="0,5,0,10" FontSize="16" Padding="5" VerticalContentAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Email:" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtEmail" Grid.Row="1" Grid.Column="1" Margin="0,5,0,10" FontSize="16" Padding="5" VerticalContentAlignment="Center"/>
                 
                    <Label Grid.Row="3" Grid.Column="0" Content="Vai trò:" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cbRole" Grid.Row="3" Grid.Column="1" Margin="0,5,0,10" FontSize="16" Padding="5" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Citizen"/>
                        <ComboBoxItem Content="TrafficPolice"/>
                        <ComboBoxItem Content="Admin"/>
                    </ComboBox>

                    <Label Grid.Row="4" Grid.Column="0" Content="Số điện thoại:" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtPhone" Grid.Row="4" Grid.Column="1" Margin="0,5,0,10" FontSize="16" Padding="5" VerticalContentAlignment="Center"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Địa chỉ:" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtAddress" Grid.Row="5" Grid.Column="1" Margin="0,5,0,10" FontSize="16" Padding="5" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Nút Lưu và Hủy -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="555,20,0,20" Grid.Column="1">
                <Button x:Name="btnSave" Content="Lưu" Width="140" Height="45" Background="Green" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0" Click="btnSave_Click"/>
                <Button x:Name="btnCancel" Content="Hủy" Width="140" Height="45" Background="#FF6B6B" Foreground="White" FontSize="16" FontWeight="SemiBold" Click="btnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
