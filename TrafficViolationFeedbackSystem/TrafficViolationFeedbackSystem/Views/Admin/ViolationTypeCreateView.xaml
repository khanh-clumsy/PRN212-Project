<UserControl x:Class="TrafficViolationFeedbackSystem.Views.Admin.ViolationTypeCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid Margin="20">
        <Border Background="#F5F7FA" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Tiêu đề -->
                    <RowDefinition Height="Auto"/>
                    <!-- Name -->
                    <RowDefinition Height="Auto"/>
                    <!-- Description -->
                    <RowDefinition Height="Auto"/>
                    <!-- Standard Fine -->
                    <RowDefinition Height="Auto"/>
                    <!-- Submit Button -->
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <TextBlock Grid.Row="0" Text="Create New Violation Type" FontSize="28" FontWeight="Bold" 
                           Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="#2C3E50"/>

                <!-- Name -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding NewViolationType.Name, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7"/>
                </Grid>

                <!-- Description -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Description:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding NewViolationType.Description, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Standard Fine -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Standard Fine:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding NewViolationType.StandardFine, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\} VND}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Submit Button -->
                <Button Grid.Row="4" Content="Submit" Margin="0,20,0,0" Padding="10,2" 
                Command="{Binding SubmitCommand}" HorizontalAlignment="Right" Width="100"  
                 Background="#2ECC71" />
            </Grid>
    
        </Border>
    </Grid>
</UserControl>
