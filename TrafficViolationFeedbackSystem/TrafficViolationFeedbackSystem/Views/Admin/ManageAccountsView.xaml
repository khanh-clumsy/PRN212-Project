<UserControl x:Class="TrafficViolationFeedbackSystem.Views.Admin.ManageAccountsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficViolationFeedbackSystem.Views.Admin"
        mc:Ignorable="d"
        d:DesignHeight="756" d:DesignWidth="1144">
    <Grid Background="#FFFFFF" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" 
                   Text="Quản lý tài khoản" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="#007BFF" 
                   Margin="20,30,0,10"
                   HorizontalAlignment="Left"/>

        <!-- Các nút Thêm, Sửa, Xóa -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,20,0,20">
            <Button x:Name="btnAddUser"
                    Content="➕ Thêm" 
                    Width="100" 
                    Height="35" 
                    Background="Green" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="SemiBold" 
                    Margin="0,0,10,0"
                    Click="btnAddUser_Click"/>
            <Button x:Name="btnEditUser"
                    Content="✏️ Sửa" 
                    Width="100" 
                    Height="35" 
                    Background="#007BFF" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="SemiBold" 
                    Margin="0,0,10,0"
                    Click="btnEditUser_Click"/>
            <Button x:Name="btnDeleteUser"
                    Content="🗑️ Xóa" 
                    Width="100" 
                    Height="35" 
                    Background="#FF6B6B" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="SemiBold" 
                    Margin="0,0,10,0"
                    Click="btnDeleteUser_Click"/>
            <!-- fillter -->
            <Label Content="Tìm tên người dùng:" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   VerticalAlignment="Center" 
                   Margin="20,0,5,0"/>
            <TextBox x:Name="txtFilterName" 
                     Width="200" 
                     Height="35" 
                     Margin="20,0,10,0" 
                     FontSize="12" 
                     VerticalContentAlignment="Center" 
                     Padding="5" 
                     ToolTip="Nhập tên để lọc"/>
            <Button x:Name="btnFilter"
                    Content="🔍 Lọc" 
                    Width="100" 
                    Height="35" 
                    Background="#FFC107" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="SemiBold" 
                    Margin="0,0,10,0"
                    Click="btnFilter_Click"/>
            <Button x:Name="btnReload"
                    Content="↻ Tải lại" 
                    Width="100" 
                    Height="35" 
                    Background="Pink" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="SemiBold" 
                    Margin="0,0,0,0"
                    Click="btnReload_Click"/>

        </StackPanel>

        <!-- Danh sách tài khoản -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="20">
            <DataGrid x:Name="UsersGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      BorderThickness="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="50"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="100"/>
                    <DataGridTextColumn Header="Số điện thoại" Binding="{Binding Phone}" Width="*"/>
                    <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
