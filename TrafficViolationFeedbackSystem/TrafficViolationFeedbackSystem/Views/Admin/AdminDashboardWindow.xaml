<Window x:Class="TrafficViolationFeedbackSystem.Views.Admin.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficViolationFeedbackSystem.Views.Admin"
        mc:Ignorable="d"      
        Title="AdminDashboardWindow" Width="1344" Height="756"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid>
        <!-- Sidebar -->
        <Grid Width="200" Background="LightGray" HorizontalAlignment="Left">
            <StackPanel Margin="10">
                <TextBlock Text="⚙️ Admin Panel" FontWeight="Bold" FontSize="18" Margin="0 10"/>

                <Button x:Name="btnManageAccounts"
            Content="👤 Manage Accounts"                 
            Margin="0 5" Height="40"
            Background="Transparent" BorderThickness="0"
            FontSize="14" Foreground="Black"
            HorizontalContentAlignment="Left" Padding="10 0"
            Click="btnManageAccounts_Click"   />

                <Button x:Name="btnViolationStatistics"
            Content="📊 Violation Statistics"
            Margin="0 5" Height="40"
            Background="Transparent" BorderThickness="0"
            FontSize="14" Foreground="Black"
            HorizontalContentAlignment="Left" Padding="10 0"
            Click="btnViolationStatistics_Click"        />

                <Button x:Name="btnViolationTypes"
            Content="🚦 Violation Types"
            Margin="0 5" Height="40"
            Background="Transparent" BorderThickness="0"
            FontSize="14" Foreground="Black"
            HorizontalContentAlignment="Left" Padding="10 0"
            Click="btnViolationTypes_Click"        />

                <Button x:Name="btnLogout"
            Content="🔙 Logout"
            Width="120" 
            Margin="0 20 0 5" Height="40"
            Background="#FF6B6B" Foreground="White"
            BorderThickness="0" FontWeight="Bold"              
            Click="btnLogout_Click" />
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <Grid Margin="200,0,0,0">

            <Image Source="/Assets/Image/admin.jpg"
        Stretch="UniformToFill"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"       
          />

            <!-- Nội dung chính -->
            <Grid Grid.Column="1" Height="740" VerticalAlignment="Bottom">
                <ContentControl x:Name="MainContent" />
            </Grid>

        </Grid>
    </Grid>
</Window>
