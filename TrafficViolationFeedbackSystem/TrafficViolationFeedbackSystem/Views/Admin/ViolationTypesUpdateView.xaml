<UserControl x:Class="TrafficViolationFeedbackSystem.Views.Admin.ViolationTypesUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid Margin="20">
        <Border Background="#F5F7FA" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Tiêu đề -->
                    <RowDefinition Height="Auto"/>
                    <!-- Violation Type ID -->
                    <RowDefinition Height="Auto"/>
                    <!-- Name -->
                    <RowDefinition Height="Auto"/>
                    <!-- Description -->
                    <RowDefinition Height="Auto"/>
                    <!-- Standard Fine -->
                    <RowDefinition Height="Auto"/>
                    <!-- Update Button -->
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <TextBlock Grid.Row="0" Text="Update Violation Type" FontSize="28" FontWeight="Bold" 
                           Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="#2C3E50"/>

                <!-- Violation Type ID -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ID:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding UpdatedViolationType.ViolationTypeId, UpdateSourceTrigger=PropertyChanged}" 
                             IsEnabled="False" Background="#ECF0F1" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Name -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding UpdatedViolationType.Name, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Description -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Description:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding UpdatedViolationType.Description, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Standard Fine -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Standard Fine:" VerticalAlignment="Center" FontSize="16" 
                               Margin="0,5,10,5" Foreground="#34495E"/>
                    <TextBox Grid.Column="1" Margin="0,5,0,5" Width="300" Text="{Binding UpdatedViolationType.StandardFine, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\} VND}" 
                             Background="#FFFFFF" BorderBrush="#BDC3C7" />
                </Grid>

                <!-- Update Button -->
                <Button Grid.Row="5" Content="Update" Margin="0,20,20,0" Padding="15,5" 
                        Command="{Binding UpdateCommand}" HorizontalAlignment="Right" Width="120" Background="#2ECC71" 
                        Foreground="White" BorderThickness="0" >
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
