<Window x:Class="TrafficViolationFeedbackSystem.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficViolationFeedbackSystem.Views"
        mc:Ignorable="d"
        Title="Đăng ký tài khoản"
        Width="1344" Height="756"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>

        <!-- Bên trái: Ảnh -->
        <Image Grid.Column="0" 
               Source="/Assets/Image/banner_login.png" 
               Stretch="Fill"/>

        <!-- Bên phải: Form đăng ký -->
        <Border Grid.Column="1" Background="#F5F5F5">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
                    <TextBlock Text="Tạo tài khoản"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,0,0,30"
                               HorizontalAlignment="Center"
                               Foreground="#333"/>

                    <TextBlock Text="Email"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail"
                             Height="35"
                             Padding="5"
                             Margin="0,0,0,15"
                             FontSize="14"/>

                    <TextBlock Text="Mật khẩu"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="pwdPassword"
                                 Height="35"
                                 Padding="5"
                                 Margin="0,0,0,15"
                                 FontSize="14"/>

                    <TextBlock Text="Xác nhận mật khẩu"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="pwdConfirmPassword"
                                 Height="35"
                                 Padding="5"
                                 Margin="0,0,0,20"
                                 FontSize="14"/>

                    <Button x:Name="btnRegister"
                            Content="Đăng ký"
                            Height="40"
                            Background="#007BFF"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Medium"
                            Click="btnRegister_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0056b3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock x:Name="tblLogin"
                               Text="Bạn đã có tài khoản? Đăng nhập"
                               FontSize="12"
                               Foreground="#007BFF"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"
                               Cursor="Hand"
                               MouseLeftButtonDown="tblLogin_MouseLeftButtonDown">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
