<UserControl x:Class="TrafficViolationFeedbackSystem.Views.Citizen.AllFineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Bộ lọc -->
            <RowDefinition Height="*"/>
            <!-- Danh sách -->
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Text="📩 Danh sách khoản phạt đã ghi nhận"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#007BFF"
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- Bộ lọc -->
        <Border Background="#007BFF" Padding="10" CornerRadius="4" Grid.Row="1" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Tìm kiếm theo tên vi phạm:"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtSearch"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         Background="White"
                         Foreground="Black"
                         Margin="5,0"/>

                <TextBlock Text="Lọc theo trạng thái"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="cbStatus"
                          Grid.Column="4"
                          VerticalAlignment="Center"
                          Margin="5,0"
                          Background="White"
                          Foreground="Black"
                          SelectedIndex="0">
                    <ComboBoxItem x:Name="AllStatusItem" IsSelected="True" Content="Tất cả"/>
                    <ComboBoxItem Content="Đã thanh toán"/>
                    <ComboBoxItem Content="Chưa thanh toán"/>
                    <ComboBoxItem Content="Thất bại"/>
                </ComboBox>
                <Button x:Name="btnFilter" Grid.Column="5"
                    Content="Lọc"
                    Width="60"
                    Height="28"
                    Margin="-350,0,0,0"
                    VerticalAlignment="Center"
                    Click="btnFilter_Click"/>
            </Grid>
        </Border>

        <!-- Danh sách khoản phạt -->
        <DataGrid x:Name="dgFines"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã hóa đơn" Binding="{Binding FineID}" Width="1*"/>
                <DataGridTextColumn Header="Vi phạm" Binding="{Binding ViolationName}" Width="3*" />
                <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount}" Width="2*"/>
                <DataGridTextColumn Header="Ngày thanh toán" Binding="{Binding PaymentDate, StringFormat='dd/MM/yyyy'}" Width="2*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding DisplayResult}" Width="2*"/>
                <DataGridTextColumn Header="Mã giao dịch" Binding="{Binding TransactionCode}" Width="2*"/>
                <DataGridTextColumn Header="Hình thức thanh toán" Binding="{Binding PaymentMethod}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
