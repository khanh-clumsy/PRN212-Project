<UserControl x:Class="TrafficViolationFeedbackSystem.Views.Citizen.ReportViolationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Form Centered -->
                <Grid HorizontalAlignment="Center" Width="700" Margin="0,30">
                    <StackPanel>
                        <!-- Tiêu đề -->
                        <TextBlock Text="🚦 Gửi phản ánh vi phạm"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#007BFF"
                                   HorizontalAlignment="Center"

                                   Margin="0,0,0,40"/>

                        <!-- Biển số xe -->
                        <TextBlock Text="Biển số xe - Biển số xe phải đúng định dạng. VD: 30A-12345" FontSize="18" FontWeight="SemiBold" Margin="0,10"/>
                        <TextBox x:Name="txtPlateNumber"
                                 Height="45"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,15"/>

                        <!-- Loại vi phạm -->
                        <TextBlock Text="Loại vi phạm:" FontSize="18" FontWeight="SemiBold" Margin="0,10"/>
                        <ComboBox x:Name="cbViolationType"
                                  Height="45"
                                  VerticalContentAlignment="Center"
                                  FontSize="16"
                                  Margin="0,0,0,15"
                                  DisplayMemberPath="ViolationName"
                                  SelectedValuePath="ViolationTypeID"
                                  SelectedIndex="-1">
                        </ComboBox>

                        <!-- Mô tả -->
                        <TextBlock Text="Mô tả chi tiết:" FontSize="18" FontWeight="SemiBold" Margin="0,10"/>
                        <TextBox x:Name="txtDescription"
                                 Height="120"
                                 FontSize="16"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,15"/>

                        <!-- Địa điểm -->
                        <TextBlock Text="Địa điểm xảy ra:" FontSize="18" FontWeight="SemiBold" Margin="0,10"/>
                        <TextBox x:Name="txtLocation"
                                 Height="45"
                                 FontSize="16"
                                 Margin="0,0,0,30"
                                 VerticalContentAlignment="Center"/>
                        <!-- Chọn file đính kèm -->
                        <TextBlock Text="File minh chứng (ảnh/video):" FontSize="18" FontWeight="SemiBold" Margin="0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="📎 Chọn file" 
                                Width="120" 
                                Height="40" 
                                FontSize="16" 
                                Click="btnChooseFile_Click"/>
                            <TextBlock x:Name="txtFileName" 
                                   Text="Chưa chọn file" 
                                   VerticalAlignment="Center" 
                                   FontSize="14" 
                                   Margin="10,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Nút gửi -->
                        <Button x:Name="btnSubmitReport"
                                Content="📤 Gửi phản ánh"
                                Background="#007BFF"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="Bold"
                                Height="50"
                                Width="250"
                                HorizontalAlignment="Center"
                                Cursor="Hand"
                                Click="btnSubmitReport_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
