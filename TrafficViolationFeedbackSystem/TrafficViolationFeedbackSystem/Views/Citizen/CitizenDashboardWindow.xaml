<Window x:Class="TrafficViolationFeedbackSystem.Views.Citizen.CitizenDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficViolationFeedbackSystem.Views.Citizen"
        mc:Ignorable="d"
        Title="Citizen Dashboard"
        Width="1344" Height="756"
        Background="#F0F4F8"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">


	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="260"/>
			<!-- Sidebar cố định -->
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Sidebar -->
		<Grid Grid.Column="0" VerticalAlignment="Center" Background="#F5F5F5" Height="720">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0">
				<TextBlock Text="🚗VNTRAFFIC"
               FontSize="30"
               Foreground="#007BFF"
               FontWeight="Bold"
               Margin="20"
               HorizontalAlignment="Center" />

				<Button x:Name="btnHome"
            Content="🏠 Trang chủ"
            Style="{StaticResource ModernButton}"
            Background="Transparent"
            Foreground="#007BFF"
            Width="220"
            Click="btnHome_Click"/>

				<Button x:Name="btnProfile"
            Content="👤 Hồ sơ cá nhân"
            Style="{StaticResource ModernButton}"
            Background="Transparent"
            Foreground="#007BFF"
            Width="220"
            Click="btnProfile_Click"/>

				<Button x:Name="btnLogout"
                    Content="🚪 Đăng xuất"
                    Style="{StaticResource ModernButton}"
                    Background="Transparent"
                    Foreground="#007BFF"
                    Width="220"
                    Click="btnLogout_Click"/>
			</StackPanel>
		</Grid>

		<!-- Nội dung chính -->
		<Grid Grid.Column="1" Height="740" VerticalAlignment="Bottom">
			<ContentControl x:Name="MainContent" Margin="0,0,10,0"/>
		</Grid>
	</Grid>
</Window>
