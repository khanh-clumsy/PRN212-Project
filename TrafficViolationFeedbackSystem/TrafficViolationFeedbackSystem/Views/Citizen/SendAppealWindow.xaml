<Window x:Class="TrafficViolationFeedbackSystem.Views.Citizen.SendAppealWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gửi Kháng Cáo"
        Height="300"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Text="📨 Gửi Kháng Cáo"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="DarkRed"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 15"/>

        <!-- Nội dung chính -->
        <StackPanel Grid.Row="1">
            <!-- Dòng mô tả loại vi phạm - ngày -->
            <TextBlock x:Name="txtSummary"
                       FontSize="14"
                       FontStyle="Italic"
                       Foreground="DarkSlateGray"
                       Margin="0 0 0 15"/>

            <!-- Nhập nội dung kháng cáo -->
            <TextBlock Text="Nội dung kháng cáo:" FontWeight="Bold"/>
            <TextBox x:Name="txtContent"
                     Height="100"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0 5 0 0"/>
        </StackPanel>

        <!-- Nút Gửi / Hủy -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0">
            <Button Content="Gửi"
                    Width="100"
                    Margin="0 0 10 0"
                    Background="DarkGreen"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Submit_Click"/>
            <Button Content="Hủy"
                    Width="80"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
