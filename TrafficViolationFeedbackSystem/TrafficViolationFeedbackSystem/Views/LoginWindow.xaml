<Window x:Class="TrafficViolationFeedbackSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficViolationFeedbackSystem.Views"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.6*"/>
            <ColumnDefinition Width="0.4*"/>
        </Grid.ColumnDefinitions>

        <!-- Left side: Image (40%) -->
        <Image Grid.Column="0" 
               Source="/Assets/Image/banner_login.jpg" 
               Stretch="Fill"/>

        <!-- Right side: Login form (60%) -->
        <Border Grid.Column="1" Background="#F5F5F5" Padding="30">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
                <TextBlock Text="Welcome Back" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Margin="0,0,0,30"
                          HorizontalAlignment="Center"
                          Foreground="#333"/>

                <TextBlock Text="Username" 
                          FontSize="14" 
                          Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername" 
                        Height="35" 
                        Padding="5" 
                        Margin="0,0,0,15"
                        FontSize="14"/>

                <TextBlock Text="Password" 
                          FontSize="14" 
                          Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" 
                           Height="35" 
                           Padding="5" 
                           Margin="0,0,0,20"
                           FontSize="14"/>

                <Button x:Name="btnLogin"
                        Content="Login" 
                        Height="40" 
                        Background="#007BFF" 
                        Foreground="White" 
                        FontSize="16"
                        FontWeight="Medium"
                        Click="btnLogin_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0056b3"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="Forgot Password?" 
                          FontSize="12" 
                          Foreground="#007BFF" 
                          HorizontalAlignment="Center" 
                          Margin="0,10,0,0"
                          Cursor="Hand">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>