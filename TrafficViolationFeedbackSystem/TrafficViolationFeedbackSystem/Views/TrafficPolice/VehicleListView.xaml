<UserControl x:Class="TrafficViolationFeedbackSystem.Views.TrafficPolice.VehicleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrafficViolationFeedbackSystem.Views.TrafficPolice"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Section -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <TextBox x:Name="PlateSearchBox"
                     Width="250"
                     Height="30"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"/>
            <Button Content="🔍 Tìm kiếm"
                    Width="100"
                    Height="30"
                    Click="SearchButton_Click"/>
        </StackPanel>

        <!-- Vehicle List -->
        <DataGrid x:Name="VehicleDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Biển số" Binding="{Binding PlateNumber}" Width="1.2*" />
                <DataGridTextColumn Header="Hãng xe" Binding="{Binding Brand}" Width="0.7*" />
                <DataGridTextColumn Header="Dòng xe" Binding="{Binding Model}" Width="0.7*" />
                <DataGridTextColumn Header="Năm sản xuất" Binding="{Binding ManufactureYear}" Width="0.7*" />
                <DataGridTextColumn Header="Chủ sở hữu" Binding="{Binding Owner.FullName}" Width="1.5*" />
                <DataGridTextColumn Header="Email chủ xe" Binding="{Binding Owner.Email}" Width="2*" />

                <!-- Action buttons column -->
                <DataGridTemplateColumn Header="Hành động" Width="1*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Sửa"
                                        Click="EditButton_Click"
                                        Tag="{Binding VehicleId}"
                                        Width="50" Height="25" Margin="2,0,5,0"/>
                                <Button Content="Xóa"
                                        Click="DeleteButton_Click"
                                        Tag="{Binding VehicleId}"
                                        Width="50" Height="25" Margin="0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
