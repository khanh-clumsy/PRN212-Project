<UserControl x:Class="TrafficViolationFeedbackSystem.Views.TrafficPolice.ProfileUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficViolationFeedbackSystem.Views.Citizen"
        mc:Ignorable="d"
        d:DesignHeight="740" d:DesignWidth="1084">
    <Grid Background="#FFFFFF" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" 
                   Text="Hồ sơ cá nhân" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="#007BFF" 
                   Margin="0,0,0,20" 
                   HorizontalAlignment="Left"/>

        <!-- Thông tin hồ sơ -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Họ và tên:" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                        <TextBox x:Name="txtFullName" Grid.Column="1" FontSize="16" 
                          BorderThickness="1" BorderBrush="Gray" Background="Transparent"/>
                    </Grid>
                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Email:" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                        <TextBox x:Name="txtEmail" Grid.Column="1" FontSize="16" 
                          BorderThickness="1" BorderBrush="Gray" Background="Transparent"/>
                    </Grid>
                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Số điện thoại:" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                        <TextBox x:Name="txtPhone" Grid.Column="1" FontSize="16" 
                          BorderThickness="1" BorderBrush="Gray" Background="Transparent"/>
                    </Grid>
                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Địa chỉ:" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                        <TextBox x:Name="txtAddress" Grid.Column="1" FontSize="16" 
                          BorderThickness="1" BorderBrush="Gray" Background="Transparent"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Nút Cập Nhật -->
        <Button Grid.Row="1" Content="Cập Nhật" 
         Width="120" Height="40" Background="Green" Foreground="White" 
         FontSize="16" FontWeight="SemiBold" Margin="0,233,10,370" 
         HorizontalAlignment="Right" Click="UpdateButton_Click"/>
        <!-- Danh sách phương tiện -->
        <StackPanel Grid.Row="1" Margin="0,253,0,20">
            <TextBlock Text="Danh sách phương tiện" 
               FontSize="20" 
               FontWeight="SemiBold" 
               Foreground="#007BFF" 
               Margin="0,0,0,10"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="10">
                <DataGrid x:Name="dgVehicles" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  BorderThickness="0"
                  Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mẫu xe" 
                                  Binding="{Binding Model}" 
                                  Width="*"/>
                        <DataGridTextColumn Header="Biển số" 
                                  Binding="{Binding PlateNumber}" 
                                  Width="*"/>
                        <DataGridTextColumn Header="Hãng xe" 
                                  Binding="{Binding Brand}" 
                                  Width="*"/>

                        <DataGridTextColumn Header="Năm sản xuất" 
                                  Binding="{Binding ManufactureYear}" 
                                  Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>