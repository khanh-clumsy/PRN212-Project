<Window x:Class="TrafficViolationFeedbackSystem.Views.TrafficPolice.ReportDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết phản ánh" Height="500" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Chi tiết phản ánh" FontSize="24" FontWeight="Bold" Foreground="#007BFF" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtReportId" FontWeight="Bold"/>
            <TextBlock x:Name="txtPlateNumber"/>
            <TextBlock x:Name="txtViolationType"/>
            <TextBlock x:Name="txtDescription" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtLocation"/>
            <TextBlock x:Name="txtReportDate"/>
            <TextBlock x:Name="txtStatus"/>
        </StackPanel>
        <GroupBox Header="File đính kèm" Grid.Row="1">
            <ListBox x:Name="lstAttachments">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FilePath}" Width="300"/>
                            <Button Content="Xem" Margin="10,0,0,0" Click="btnViewAttachment_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</Window> 